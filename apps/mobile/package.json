{
  "name": "@unoword/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "npm run editor:build && expo start",
    "start:tunnel": "npm run editor:build && expo start --tunnel",
    "ios": "npm run editor:build && expo start --ios",
    "editor:build": "node scripts/build-editor.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:ios": "npm run editor:build && expo export --platform ios",
    "doctor": "npx expo-doctor",
    "postinstall": "npm run editor:build"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "^2.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.99.0",
    "@tanstack/react-query": "5.101.4",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "expo": "58.0.23",
    "expo-auth-session": "~58.0.17",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.3.0",
    "esbuild": "^0.27.0",
    "react-native-web": "^0.21.4",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2"
  }
}
