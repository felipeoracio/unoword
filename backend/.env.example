CORS_ORIGINS=your_cors_origins_here
AI_AUTH_MODE=your_ai_auth_mode_here
AI_PROVIDER=your_ai_provider_here
AI_MODEL=your_ai_model_here
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBED_MODEL=your_openai_embed_model_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
SUPABASE_DB_URL=your_supabase_db_url_here
SUPABASE_JWT_AUDIENCE=authenticated
OPENAI_API_KEY=your_openai_api_key_here
AI_REQUIRE_SUBSCRIPTION=true
AI_EMBED_CACHE_SIZE=512
AI_MAX_DRAFT_CHARS=2000
AI_MAX_CONTEXT_CHARS=6000
AI_DAILY_REQUEST_LIMIT=25
ADMIN_EMAIL=your_admin_email_here
ADMIN_INITIAL_PASSWORD=your_admin_initial_password_here
ADMIN_JWT_SECRET=your_admin_jwt_secret_here

# See docs/account-security-and-profiles.md before enabling email mutations.
PUBLIC_APP_URL=https://unoword.vercel.app
AUTH_ALLOWED_ORIGINS=
AUTH_SECURITY_EMAILS_CONFIGURED=false

# Set only after publishing and verifying the real Chrome Web Store listing.
PUBLIC_CHROME_STORE_URL=

# Stripe: start with sandbox/test-mode values. Never add these to frontend/extension envs.
# Apply supabase/migrations/20261021010000_stripe_billing.sql first.
# Configure the default Stripe portal: payment methods + cancellation at period end;
# disable subscription updates. See docs/stripe-billing.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BILLING_ENABLED=false

# Leave false until the owner explicitly approves live billing. Live keys alone are rejected.
STRIPE_LIVE_BILLING_APPROVED=false

# Writing workspace: apply 20261023010000_writing_workspace.sql first.
# Editor AI reuses existing provider settings and per-account daily quotas.
WRITING_DEFAULT_DAILY_GOAL=250

# First 25 lifetime purchasers, $100 one-time; sandbox/test keys only.
# Apply supabase/migrations/20261026010000_lifetime_offer.sql.
# Create an active USD 100.00 one-time Stripe test price, not a recurring price.
STRIPE_LIFETIME_PRICE_ID=
STRIPE_LIFETIME_ENABLED=false
# Existing signed webhook must also receive checkout.session.completed,
# checkout.session.expired, charge.refunded, charge.dispute.created/updated/closed.
# Lifetime checkout rejects live keys even when general live approval is enabled.
