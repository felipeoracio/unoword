{
  "manifest_version": 3,
  "name": "UnoWord \u2014 Writing Assistant",
  "short_name": "UnoWord",
  "version": "0.16.4",
  "description": "A minimal, private writing session tracker with goals, prompts and progress. Click Start, type anywhere in Chrome, click Stop \u2014 see exactly how many words you wrote.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "UnoWord \u2014 Writing Assistant"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://chrome.google.com/webstore/*",
        "*://chromewebstore.google.com/*"
      ],
      "js": [
        "shared/wordcount.js",
        "shared/i18n.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://unoword.vercel.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
