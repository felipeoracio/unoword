{
  "manifest_version": 3,
  "name": "UnoWord \u2014 Writing Assistant",
  "short_name": "UnoWord",
  "version": "0.20.0",
  "description": "Track typed words in supported Chrome editors, set daily goals, build writing habits, and find your next writing direction with UnoWord.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "UnoWord \u2014 Writing Assistant"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://chrome.google.com/webstore/*",
        "*://chromewebstore.google.com/*"
      ],
      "js": [
        "shared/wordcount.js",
        "shared/i18n.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://unoword.vercel.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
