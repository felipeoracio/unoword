{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "server.py",
      "mount": "/api"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "mount": "/",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  }
}
